<section class="featured-collection">
  <div class="featured-collection-inner">
    <div class="featured-collection-header">
      <p class="eyebrow">{{ section.settings.eyebrow }}</p>
      <h2>{{ section.settings.heading }}</h2>
      <p class="featured-subtitle">{{ section.settings.subtitle }}</p>
      {% if section.settings.collection != blank %}
        <a class="button ghost" href="{{ collections[section.settings.collection].url }}">Shop the collection</a>
      {% endif %}
    </div>

    {% if section.settings.collection != blank %}
      {% assign featured_collection = collections[section.settings.collection] %}
      <div class="product-grid">
        {% for product in featured_collection.products limit: section.settings.product_limit %}
          <article class="product-card">
            <a href="{{ product.url }}">
              {% if product.featured_image %}
                <img src="{{ product.featured_image | image_url: width: 600 }}" alt="{{ product.featured_image.alt | escape }}">
              {% endif %}
              <h3>{{ product.title }}</h3>
              <p class="price">{{ product.price | money }}</p>
            </a>
          </article>
        {% endfor %}
      </div>
    {% else %}
      <p class="empty-state">Select a collection to feature products here.</p>
    {% endif %}
  </div>
</section>

{% schema %}
{
  "name": "Featured collection",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "House favorites"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "The Belluci edit"
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "Curated essentials and statement pieces selected by our atelier for the season."
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "product_limit",
      "label": "Products to show",
      "min": 3,
      "max": 8,
      "step": 1,
      "default": 4
    }
  ],
  "presets": [
    {
      "name": "Featured collection"
    }
  ]
}
{% endschema %}
