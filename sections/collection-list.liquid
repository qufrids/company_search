<section class="collection-list">
  <div class="collection-list-inner">
    <p class="eyebrow">{{ section.settings.eyebrow }}</p>
    <h2>{{ section.settings.heading }}</h2>
    <div class="collection-list-grid">
      {% for block in section.blocks %}
        {% assign collection = collections[block.settings.collection] %}
        <article class="collection-tile">
          <a href="{{ collection.url }}">
            {% if collection.featured_image %}
              <img src="{{ collection.featured_image | image_url: width: 800 }}" alt="{{ collection.featured_image.alt | escape }}">
            {% endif %}
            <div class="collection-tile-content">
              <h3>{{ collection.title }}</h3>
              <span>Shop now</span>
            </div>
          </a>
        </article>
      {% endfor %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Collection list",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Collections"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Explore the house"
    }
  ],
  "blocks": [
    {
      "type": "collection",
      "name": "Collection",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection"
        }
      ]
    }
  ],
  "max_blocks": 4,
  "presets": [
    {
      "name": "Collection list",
      "blocks": [
        {"type": "collection"},
        {"type": "collection"},
        {"type": "collection"}
      ]
    }
  ]
}
{% endschema %}
